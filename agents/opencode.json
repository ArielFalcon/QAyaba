{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "./AGENTS.md"
  ],
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0"
  },
  "tools": {
    "run_spec": false,
    "authbrowser_navigate": false,
    "authbrowser_snapshot": false,
    "authbrowser_click": false,
    "authbrowser_type": false,
    "set_geolocation": false,
    "codegraph_search_graph": false,
    "codegraph_trace_path": false,
    "codegraph_get_code_snippet": false
  },
  "permission": {
    "doom_loop": "deny",
    "external_directory": {
      "*": "deny",
      "~/.config/opencode/skill/*": "allow"
    }
  },
  "provider": {
    "deepseek-api": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek API",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "id": "deepseek-flash",
          "name": "DeepSeek V4.1 Flash",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 393216
          }
        }
      }
    }
  },
  "agent": {
    "qa-generator": {
      "description": "Generates Playwright E2E tests for a commit's blast radius and writes them in e2e/. Has serena+playwright MCP access by design (test author), except the tools that run code, push a file or open a shell (browser_run_code_unsafe, browser_evaluate, browser_file_upload, browser_drop, execute_shell_command). It has no shell at all (permission.bash is denied outright, for every target): the orchestrator's Validate and Execute phases compile, lint, list and run what it writes. Enforced here: no shell, no code-running or file-pushing browser tool. Not enforced: browser_click, browser_type and browser_fill_form can still submit a form on DEV through the UI, which only the prompt forbids (live DEV is observed while authoring; a generated spec is what writes to it). It also holds the authbrowser_* tools, served by the orchestrator: a read-only browser signed in as the test account, whose session the agent never holds; the orchestrator refuses them unless the run granted them. As the lead it also holds the codegraph_* tools, served by the orchestrator: read-only queries of the run's own project in the code graph (search symbols, trace callers and callees, read a symbol's source); the orchestrator refuses them unless the run granted them.",
      "mode": "primary",
      "model": "deepseek-api/deepseek-v4.1-flash",
      "options": { "reasoningEffort": "high" },
      "prompt": "{file:./agent/qa-generator.md}",
      "tools": {
        "write": true,
        "edit": true,
        "read": true,
        "run_spec": true,
        "authbrowser_navigate": true,
        "authbrowser_snapshot": true,
        "authbrowser_click": true,
        "authbrowser_type": true,
        "set_geolocation": true,
        "codegraph_search_graph": true,
        "codegraph_trace_path": true,
        "codegraph_get_code_snippet": true,
        "webfetch": false,
        "playwright_browser_run_code_unsafe": false,
        "playwright_browser_evaluate": false,
        "playwright_browser_file_upload": false,
        "playwright_browser_drop": false,
        "serena_execute_shell_command": false,
        "browser_run_code_unsafe": false,
        "browser_evaluate": false,
        "browser_file_upload": false,
        "browser_drop": false,
        "execute_shell_command": false
      },
      "permission": {
        "bash": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "**/.env*": "deny",
          "**/e2e/.auth/**": "deny",
          "**/storageState*.json": "deny",
          "**/client.p12": "deny",
          "**/cert.pass": "deny",
          "*.env.example": "allow"
        }
      },
      "maxSteps": 250,
      "temperature": 0.2
    },
