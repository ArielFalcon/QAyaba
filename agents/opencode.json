    "qa-assistant": {
      "description": "Read-only run Q&A for the interactive layer (TUI chat). Tool-less: answers ONLY from the run context injected in the prompt (the operator-assistant context's buildRunChatContext and buildRunContext deterministically embed run outcomes as text). ALL MCP toolsets (serena/playwright) are explicitly denied.",
      "mode": "primary",
      "model": "opencode-go/glm-5.3-flash",
      "prompt": "{file:./agent/qa-assistant.md}",
      "tools": {
        "write": false,
        "edit": false,
        "read": false,
        "bash": false,
        "serena*": false,
        "playwright*": false,
        "activate_project": false,
