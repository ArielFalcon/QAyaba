      "maxSteps": 250,
      "temperature": 0.2
    },
    "qa-reviewer": {
      "description": "Independent E2E quality judge, invoked directly by the orchestrator's ReviewPortAdapter (not delegated to by another agent) — mode is \"all\" because OpenCode's \"subagent\" mode is for agents other primary agents delegate to, which does not describe this invocation path. Does not write: emits a JSON verdict. Holds NO MCP access (serena/playwright both denied) so its independence is enforced by the runtime, not prompt etiquette.",
      "mode": "all",
      "model": "opencode-go/minimax-m3.1-flash",
      "options": { "thinking": { "type": "adaptive" } },
      "prompt": "{file:./agent/qa-reviewer.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "read": true,
        "submit_review": true,
        "serena*": false,
        "playwright*": false,
        "activate_project": false,
        "find_symbol": false,
        "find_referencing_symbols": false,
        "get_symbols_overview": false,
        "search_for_pattern": false,
        "list_dir": false,
        "find_file": false,
        "read_memory": false,
        "write_memory": false,
        "list_memories": false,
