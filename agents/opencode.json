      "permission": {
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "**/.env*": "deny",
          "**/e2e/.auth/**": "deny",
          "**/storageState*.json": "deny",
          "**/client.p12": "deny",
          "**/cert.pass": "deny",
          "*.env.example": "allow"
