    "qa-proposer": {
      "description": "Read-only cross-service boundary proposer. Hypothesizes the app's HTTP/event convention as candidate BoundaryProfiles for a deterministic scorer to grade against real repos. Writes nothing; emits only the verdict. Has serena MCP access by design (no playwright).",
      "mode": "primary",
      "model": "opencode-go/glm-5.3-flash",
      "prompt": "{file:./agent/qa-proposer.md}",
      "tools": {
        "write": false,
        "edit": false,
        "read": true,
        "bash": false,
        "submit_profiles": true,
        "playwright*": false,
        "browser_close": false,
        "browser_resize": false,
        "browser_console_messages": false,
        "browser_handle_dialog": false,
        "browser_evaluate": false,
        "browser_file_upload": false,
        "browser_drop": false,
        "browser_fill_form": false,
        "browser_press_key": false,
        "browser_type": false,
        "browser_navigate": false,
        "browser_navigate_back": false,
        "browser_network_requests": false,
        "browser_network_request": false,
        "browser_run_code_unsafe": false,
        "browser_take_screenshot": false,
        "browser_snapshot": false,
        "browser_click": false,
        "browser_drag": false,
        "browser_hover": false,
        "browser_select_option": false,
        "browser_tabs": false,
        "browser_wait_for": false
      },
      "maxSteps": 25,
      "temperature": 0.2,
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "**/.env*": "deny",
          "**/e2e/.auth/**": "deny",
          "**/storageState*.json": "deny",
          "**/client.p12": "deny",
          "**/cert.pass": "deny",
          "*.env.example": "allow"
        }
      }
    },
    "qa-author": {
      "description": "Test author — the one agent that writes tests. For a flow of a plan it receives a self-contained delegation brief (objective, acceptance criteria, writable/readable scope, known facts, validation plan) and may edit multiple EXISTING specs within its writable scope across follow-up feedback turns in the SAME session; for the run's own task (a login still to be written, the repo's own tests, the architecture map, corrections to what was delivered) it works in the run's working copy. Frozen authority: cannot change acceptance criteria/architecture, cannot write outside writablePaths, never performs git writes; a claimed result is externally validated against what actually exists on disk. Has serena + playwright MCP access by design, minus the tools that run code, push a file or open a shell (its built-in shell is off too). Enforced: those tools are denied. Not enforced: browser_click, browser_type and browser_fill_form can still submit a form on DEV through the UI, which only the prompt forbids. It also holds run_spec and the authbrowser_* tools, served by the orchestrator when the run granted them (run_spec only for the flow it is authoring: it runs the one spec the flow was given, once, against DEV; the browser is a read-only one signed in as the test account); a session the run did not grant them hides them. A flow's author works in a workspace of its own, a copy of what the run may read, and the orchestrator takes back only the files its brief names.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "options": { "reasoningEffort": "medium" },
      "prompt": "{file:./agent/qa-author.md}",
      "tools": {
        "write": true,
        "edit": true,
        "read": true,
        "bash": false,
        "run_spec": true,
        "authbrowser_navigate": true,
        "authbrowser_snapshot": true,
        "authbrowser_click": true,
        "authbrowser_type": true,
        "set_geolocation": true,
        "submit_result": true,
        "submit_specs": true,
        "webfetch": false,
        "playwright*": true,
        "playwright_browser_run_code_unsafe": false,
        "playwright_browser_evaluate": false,
        "playwright_browser_file_upload": false,
        "playwright_browser_drop": false,
        "serena_execute_shell_command": false,
        "browser_run_code_unsafe": false,
        "browser_evaluate": false,
        "browser_file_upload": false,
        "browser_drop": false,
        "execute_shell_command": false
      },
      "maxSteps": 300,
      "temperature": 0.3,
      "permission": {
        "bash": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "**/.env*": "deny",
          "**/e2e/.auth/**": "deny",
          "**/storageState*.json": "deny",
          "**/client.p12": "deny",
          "**/cert.pass": "deny",
          "*.env.example": "allow"
        }
      }
    }
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--transport",
        "stdio",
        "--context",
        "ide-assistant"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp",
        "--browser",
        "chromium",
        "--headless",
        "--timeout-action",
        "30000",
        "--timeout-navigation",
        "30000"
      ],
      "enabled": true
    }
  }
}
