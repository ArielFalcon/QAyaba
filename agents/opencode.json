        "think_about_task_adherence": false,
        "think_about_whether_you_are_done": false,
        "prepare_for_new_conversation": false,
        "switch_modes": false,
        "browser_close": false,
        "browser_resize": false,
        "browser_console_messages": false,
        "browser_handle_dialog": false,
        "browser_evaluate": false,
        "browser_file_upload": false,
