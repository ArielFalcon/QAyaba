{
  "name": "qayaba",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "App-agnostic AI-assisted E2E QA engine. Template: a watched app is onboarded via config/ + .env only.",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "qa": "tsx src/cli.ts",
    "onboard": "tsx scripts/onboard-app.ts",
    "contract:gen": "tsx scripts/gen-openapi.ts",
    "contract:check": "tsx scripts/check-contract-fresh.ts",
    "settings:gen": "tsx scripts/gen-settings-docs.ts",
    "settings:check": "tsx scripts/check-settings-fresh.ts",
    "sdk:gen": "openapi-typescript contract/openapi.json -o packages/sdk/src/types.gen.ts",
    "sdk:typecheck": "tsc -p packages/sdk",
    "start": "node boot-guard.mjs && tsx src/index.ts",
    "test": "node scripts/run-tests.mjs",
    "test:isolated": "node scripts/run-tests.mjs --isolated",
    "typecheck": "tsc -b qa-engine/tsconfig.json && tsc --noEmit -p tsconfig.json && tsc --noEmit -p qa-engine/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && npm run embedded:typecheck",
    "embedded:typecheck": "tsc --noEmit -p qa-engine/tsconfig.embedded.json",
    "embedded:lint": "eslint -c qa-engine/embedded.eslint.config.js \"qa-engine/src/**/embedded/**/*.cjs\"",
    "mutate": "tsx scripts/mutate.ts",
    "sandbox:smoke": "tsx scripts/sandbox-smoke.ts",
    "mutate:keystone": "tsx scripts/mutate.ts keystone",
    "efficiency-benchmark": "tsx scripts/efficiency-benchmark.ts",
    "probe-report": "tsx scripts/probe-report.ts",
    "funnel": "tsx scripts/run-funnel.ts",
    "baseline-agent": "tsx scripts/baseline-agent.ts",
    "warm-suite": "tsx scripts/warm-suite.ts",
    "campaign": "tsx scripts/campaign.ts",
    "campaign-report": "tsx scripts/campaign-compare.ts",
    "learning:quarantine": "tsx scripts/learning-quarantine.ts",
    "langfuse:labels": "tsx scripts/langfuse-labels.ts",
    "judge-calibrate": "tsx scripts/judge-calibrate.ts",
    "fault-calibrate": "tsx scripts/fault-calibration.ts",
    "label": "tsx scripts/label-run.ts",
    "previous-forms:check": "tsx scripts/check-previous-forms.ts",
    "arch:check": "depcruise --config qa-engine/.dependency-cruiser.cjs qa-engine/src src scripts",
    "seed:lint": "cd config/e2e && eslint ."
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.17.7",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@stryker-mutator/core": "^9.6.1",
    "better-sqlite3": "12.10.1",
    "playwright-core": "1.60.0",
    "tree-sitter-wasms": "0.1.13",
    "undici": "^8.4.1",
    "web-tree-sitter": "0.20.8",
    "ws": "8.18.3",
    "yaml": "^2.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/ws": "8.18.1",
    "c8": "^10.1.3",
    "dependency-cruiser": "^17.4.3",
    "eslint": "9.39.5",
    "eslint-plugin-playwright": "2.12.1",
    "openapi-typescript": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.71.1"
  }
}
