# ─────────────────────────────────────────────────────────────────────────────
# QAyaba slim — configuration. Copy to slim/.env and fill in.
# Comments go on their own line: docker compose keeps an inline "# ..." as part of the value.
# ─────────────────────────────────────────────────────────────────────────────

# === Build sources (point each one at your internal registry / Artifactory remote) ===
# Base images (Docker remote for mcr.microsoft.com and Docker Hub).
PW_IMAGE=mcr.microsoft.com/playwright:v1.60.0-noble
NODE_IMAGE=node:24-bookworm
GO_IMAGE=golang:1.26-bookworm
# npm remote (also used at run time for the e2e project's install and by Serena).
NPM_REGISTRY=https://registry.npmjs.org/
# PyPI remote (Serena), as a "simple" index URL.
PIP_INDEX_URL=https://pypi.org/simple
# Go modules remote (the terminal console).
GOPROXY=https://proxy.golang.org,direct
GOSUMDB=sum.golang.org
# Ubuntu apt remotes. Empty keeps the public archives. APT_MIRROR serves amd64
# (archive + security), APT_PORTS_MIRROR serves arm64 (Apple Silicon).
APT_MIRROR=
APT_PORTS_MIRROR=
# Generic remote for https://github.com (release downloads), unless the files are vendored in slim/vendor/.
GITHUB_RELEASES_BASE=https://github.com
# Generic remote for https://download.eclipse.org/jdtls/milestones/1.58.0 (unless vendored).
JDTLS_BASE_URL=https://download.eclipse.org/jdtls/milestones/1.58.0
# Maven remote (Lombok for the Java language server).
MAVEN_REPO=https://repo.maven.apache.org/maven2

# === Resources (Docker Desktop memory should be >= 9 GB for these defaults) ===
ORCHESTRATOR_MEMORY=2560m
AGENTS_MEMORY=4g
JDTLS_XMX=1024m
QAYABA_PORT=8080

# === Network at run time ===
# Extra hosts reached WITHOUT the corporate proxy (comma-separated), e.g. .corp.example
EXTRA_NO_PROXY=

# === LLM ===
# The key of the provider the agents use. With OpenCode Go/Zen it is that key; with a corporate
# provider declared in slim/opencode.override.json, put that provider's key here and reference it
# there as "{env:OPENCODE_API_KEY}" (the supervisor starts OpenCode only when this is set).
# Optional: the stack starts without it. Paste the day's key in the web console (agent runtime panel) or the TUI; it is kept in memory only.
OPENCODE_API_KEY=
OPENCODE_LOG_LEVEL=INFO

# === GitLab (read-only) ===
# Base URL of the SCM host; app YAMLs use repo: "group/subgroup/project".
GIT_REMOTE_BASE=https://gitlab.example.internal
# Project/Group Access Token or Deploy Token with read_repository only.
GIT_TOKEN=
# Token user: defaults to "oauth2" on non-GitHub hosts (a Deploy Token needs its username here).
GIT_TOKEN_USER=

# === DEV environment ===
# Optional HTTP Basic gate in front of the whole DEV environment.
DEV_ENV_USER=
DEV_ENV_PASS=
# The app login (central identity provider). The flow is declared per app in config/apps/<app>.yaml (e2e.auth).
DEV_TEST_USER=
DEV_TEST_PASS=

# === Console / API ===
# Empty → generated on first boot into config/.api_token (the TUI finds it there).
QA_API_TOKEN=
# HMAC secret for POST / (webhook). Empty → no signature check (loopback-only port).
WEBHOOK_SECRET=
