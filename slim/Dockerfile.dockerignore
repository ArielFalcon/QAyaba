# Build-context rules for slim/Dockerfile (BuildKit reads <Dockerfile>.dockerignore beside it).
# Unlike the root .dockerignore, client/ is INCLUDED: the image builds the terminal console.
node_modules/
**/node_modules/
.git/
.qa-store/
*.db
*.sqlite
.mirrors/
data/
qa-engine/.tsbuild/

# Secrets never enter the image. `**/` makes each rule match at any depth: without it a pattern only
# matches at the root of the context, so a nested file would be copied in.
.env
**/.env
**/.env.*
!**/.env.example
slim/.env
.api_token
**/.api_token
config/.api_token
**/*.pem
**/*.key

# Local outputs.
slim/exports/
slim/maven/
.omo/
.DS_Store
