node_modules/
dist/
.env
.env.local
config/.api_token
# Reproducible coordination benchmark cases name real commits of real watched repos (user data) —
# only the neutral-placeholder example ships tracked (see scripts/coordination-benchmark.ts).
config/benchmarks/coordination-cases.json
# Same for the agent-efficiency benchmark: its cases name real commits (user data) and its results
# hold run ids and measurements of real runs — only the example ships tracked
# (see scripts/efficiency-benchmark.ts).
config/benchmarks/efficiency-cases.json
config/benchmarks/efficiency-results/
# Watched-app configs are user data (real repo URLs, tokens-adjacent settings) — only the
# neutral-placeholder example ships tracked. A fresh clone has no app configured (see
# CLAUDE.md's Onboarding note and docs invariants).
config/apps/*
!config/apps/example.yaml
*.log
.DS_Store

# Volumen local de artefactos E2E y memoria (se persiste fuera del repo)
.qa-store/
data/
*.db
*.sqlite

# Espejos locales de los repos vigilados
.mirrors/
# Datos de runtime de continuación de runs (regenerable)
.omo/
/.idea/
/.claude/
/.sisyphus/
/.atl/
# Skill-registry cache (personal paths) inside the agents image build context.
agents/.atl/

# Per-run TUI/client-side dumps (regenerable, may embed local run data).
client/qa-run-*.json

# TypeScript project-references build artifacts (qa-engine)
qa-engine/.tsbuild/
*.tsbuildinfo
# tsc --build emits .d.ts declarations next to source files when noEmit is ignored in build mode
src/**/*.d.ts

# Test fixtures deliberately named node_modules (walk() skip-set poison fixtures) must be tracked —
# without this exception a plain `git add` silently drops them and the JD-FIX4 tests break on fresh clones.
!qa-engine/test/**/fixtures/**/node_modules/
!qa-engine/test/**/fixtures/**/node_modules/**
/.opencode/
/.superpowers/

# Mutation testing (npm run mutate): Stryker sandbox, incremental state and reports.
/.stryker-tmp/
/reports/
